generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ScanState {
  pending
  running
  succeeded
  failed
}

enum VersionStatus {
  up_to_date
  outdated
  unknown
}

enum CveSeverity {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Scan {
  id             String          @id @default(uuid())
  repoUrl        String
  searchPath     String?
  ref            String?
  state          ScanState       @default(pending)
  errorMessage   String?
  /// JSON array of strings: everything skipped or failed during the scan
  warnings       String          @default("[]")
  /// Current step (ScanPhase); null once succeeded
  phase          String?
  progressDone   Int             @default(0)
  progressTotal  Int             @default(0)
  progressDetail String?
  createdAt      DateTime        @default(now())
  finishedAt     DateTime?
  chartFindings  ChartFinding[]
  imageFindings  ImageFinding[]
  cveFindings    CveFinding[]
}

model ChartFinding {
  id                  String        @id @default(uuid())
  scan                Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId              String
  applicationName     String
  applicationSetName  String
  chartName           String
  repoUrl             String
  currentVersion      String
  latestVersion       String?
  status              VersionStatus
  note                String?

  @@index([scanId])
}

model ImageFinding {
  id               String        @id @default(uuid())
  scan             Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId           String
  applicationName  String
  image            String
  currentTag       String
  latestTag        String?
  status           VersionStatus
  note             String?
  vulnerabilitiesScanned Boolean @default(false)

  @@index([scanId])
}

model CveFinding {
  id                String       @id @default(uuid())
  scan              Scan         @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId            String
  applicationName   String
  image             String
  vulnerabilityId   String
  pkgName           String
  installedVersion  String
  fixedVersion      String?
  severity          CveSeverity
  title             String?

  @@index([scanId])
}

/// Small key/value store for app-generated settings (e.g. the session signing secret)
model AppSetting {
  key   String @id
  value String
}
