generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum ScanState {
  pending
  running
  succeeded
  failed
}

enum VersionStatus {
  up_to_date
  outdated
  unknown
}

enum CveSeverity {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// A repo that is scanned on a schedule (or on demand)
model Monitor {
  id         String   @id @default(uuid())
  repoUrl    String
  searchPath String?
  ref        String?
  /// Cron expression in the server's TZ; null = manual runs only
  schedule   String?
  /// false = paused (schedule doesn't fire)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  scans      Scan[]

  /// Notifications: off while channelId is null (also when the channel gets deleted)
  channel            NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  channelId          String?
  /// CRITICAL | HIGH | MEDIUM; null = no CVE notifications
  notifyMinSeverity  String?              @default("HIGH")
  notifyOnlyFixable  Boolean              @default(true)
  /// off | any | fixes (only versions whose upgrade fixes CVEs)
  notifyChartUpdates String               @default("any")
  notifyOnFailure    Boolean              @default(true)
}

/// Where notifications go; shared by monitors
model NotificationChannel {
  id        String    @id @default(uuid())
  name      String
  /// discord | slack | webhook
  type      String
  /// Secret: anyone with it can post to the channel
  url       String
  createdAt DateTime  @default(now())
  monitors  Monitor[]
}

model Scan {
  id             String         @id @default(uuid())
  monitor        Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId      String
  /// repoUrl/searchPath/ref as scanned (the monitor may be edited later)
  repoUrl        String
  searchPath     String?
  ref            String?
  state          ScanState      @default(pending)
  errorMessage   String?
  /// JSON array of strings: everything skipped or failed during the scan
  warnings       String         @default("[]")
  /// Current step (ScanPhase); null once succeeded
  phase          String?
  progressDone   Int            @default(0)
  progressTotal  Int            @default(0)
  progressDetail String?
  createdAt      DateTime       @default(now())
  finishedAt     DateTime?
  chartFindings  ChartFinding[]
  imageFindings  ImageFinding[]
  cveFindings    CveFinding[]

  @@index([monitorId, createdAt])
}

model ChartFinding {
  id                 String        @id @default(uuid())
  scan               Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId             String
  applicationName    String
  applicationSetName String
  chartName          String
  repoUrl            String
  currentVersion     String
  latestVersion      String?
  status             VersionStatus
  note               String?
  /// JSON ChartUpgrade; null unless outdated
  upgrade            String?

  @@index([scanId])
}

model ImageFinding {
  id                     String        @id @default(uuid())
  scan                   Scan          @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId                 String
  applicationName        String
  image                  String
  currentTag             String
  latestTag              String?
  status                 VersionStatus
  note                   String?
  vulnerabilitiesScanned Boolean       @default(false)
  /// values | chart; outdated images only
  tagSource              String?
  /// JSON LatestTagCheck
  latestTagCheck         String?

  @@index([scanId])
}

model CveFinding {
  id               String      @id @default(uuid())
  scan             Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId           String
  applicationName  String
  image            String
  vulnerabilityId  String
  pkgName          String
  installedVersion String
  fixedVersion     String?
  severity         CveSeverity
  title            String?

  @@index([scanId])
}

/// Chart versions are immutable, so their changelog is fetched once: repo|chart|version → JSON
/// ChangelogEntry[]
model ChangelogCache {
  key       String   @id
  changes   String
  createdAt DateTime @default(now())
}

/// Small key/value store for app-generated settings (e.g. the session signing secret)
model AppSetting {
  key   String @id
  value String
}
