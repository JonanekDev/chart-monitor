# Required: bcrypt hash of the login password. Generate it with
#   htpasswd -nBC 12 '' | cut -d: -f2
# and keep the single quotes, otherwise the $ signs in the hash get mangled.
ADMIN_PASSWORD_HASH=''
# Set to true only if something in front of the app already handles login (SSO proxy).
AUTH_DISABLED=false
# Behind a reverse proxy: its IP or CIDR (comma-separated), so the login rate limit counts real
# clients instead of the proxy. `true` trusts anyone, only if the app is reachable just via the proxy.
# TRUST_PROXY=10.0.0.0/8

PORT=3000
DATABASE_URL=file:./chart-monitor.db
TRIVY_SERVER_URL=http://localhost:4954

# Optional: only needed for private repos. Public repos on any git host work without tokens.
# GitHub: fine-grained token with read-only "Contents" access, sent to github.com only.
GITHUB_TOKEN=
# Any git host (GitLab, Gitea/Forgejo, self-hosted): comma-separated https://user:token@host
# entries; each token is only sent to its own host. GitLab user: oauth2, Gitea: your username.
# GIT_CREDENTIALS=https://oauth2:glpat-xxx@gitlab.com,https://jonas:xxx@gitea.example.com
GIT_CREDENTIALS=
# Private classic Helm repos: comma-separated https://user:password@host/path (longest prefix wins)
# HELM_REPO_CREDENTIALS=https://ci:xxx@nexus.example.com/repository/helm-private
# Private registries (image tags, OCI charts, trivy pulls): directory with a Docker config.json
# that has plain "auths" entries (see README)
# DOCKER_CONFIG=/secrets/docker

# Docker only: PEM file with an internal CA for self-hosted git/Helm (see README)
# EXTRA_CA_CERTS=/certs/internal-ca.crt

INCLUDE_PRERELEASES=false

# Time zone scan schedules are interpreted in (the container itself runs in UTC)
TZ=UTC
# Scans kept per monitor; older ones (and their findings) are deleted
SCAN_RETENTION=10
# Where the app is reachable, used for links in notifications (optional)
PUBLIC_URL=
